# 复制本文件为 .env.local 并填写

# Turso 数据库
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-token

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
# 公开供图域名：pub-<bucket>.r2.dev 或绑定的自定义域（CDN 子域）。
# 不要填 S3 API 端点（*.r2.cloudflarestorage.com），它需要 SigV4 签名、无法公开供图。
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
# 可选：历史媒体域名（逗号分隔），供 URL 归一化与删除键解析识别自有对象
R2_ALT_PUBLIC_URLS=

# 管理员密钥（生成一个长随机字符串）
ADMIN_SECRET_KEY=your-secret-key-here
# 可选：管理员令牌吊销旋钮（unix 秒），早于该时间签发的 token 失效
ADMIN_TOKEN_NOT_BEFORE=
# 可选：管理员登录限流（次 / 5 分钟，默认 10）
ADMIN_LOGIN_RATE_LIMIT=10

# 可选：定时任务调用 /api/cron/r2-delete 时使用
CRON_SECRET=your-cron-secret

# 可选：本地开发时设置
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 可选：跨实例登录限流
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TOTP 动态口令密钥（运行一次 /admin/totp-setup 获取）
TOTP_SECRET=

# QQ邮箱 SMTP（用于验证码登录）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=1193662756@qq.com
EMAIL_PASS=你的QQ邮箱授权码

# 可选：监控事件 webhook
MONITORING_WEBHOOK_URL=

# 可选：远程冒烟测试
SMOKE_BASE_URL=https://tangzihang.top
SMOKE_ALLOW_WRITES=0
# 可选：冒烟测试优先读取的管理员密钥（空则回退 ADMIN_SECRET_KEY）
ADMIN_KEY=
# 可选：设为 1 时 next.config 跳过 next/image 优化（R2 直链已 unoptimized）
NEXT_IMAGES_UNOPTIMIZED=
